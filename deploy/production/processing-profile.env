# Perfil oficial do servidor fisico, homologado em 2026-11-27 na 051-A.2.
# Sem segredos. Integrar explicitamente ao ambiente do app/worker Docker.
# Configuracao persistida em processing_settings prevalece sobre os numeros.
DATABASE_POOL_MAX=10
PROCESSING_WORKER_COUNT=10
PROCESSING_BLOCK_SIZE=80
PROCESSING_CONCURRENCY=80
PROCESSING_ERP_CONCURRENCY=80
PROCESSING_PERSISTENCE_CONCURRENCY=3
PROCESSING_PERSISTENCE_BATCH_SIZE=15
PROCESSING_MAX_BUFFERED_RESULTS=80
MENSALIDADES_API_CONNECT_TIMEOUT_MS=30000
MENSALIDADES_API_READ_TIMEOUT_MS=30000
MENSALIDADES_API_PAGE_SIZE=200
MENSALIDADES_API_MAX_PAGES=1000
PROCESSING_MAX_ATTEMPTS=3
PROCESSING_STALE_HEARTBEAT_MS=120000
PROCESSING_WORKER_CYCLE_BUDGET_MS=110000
PROCESSING_SHUTDOWN_RESERVE_MS=9000
PROCESSING_PERSISTENCE_RESERVE_MS=5000
PROCESSING_FINALIZATION_RESERVE_MS=8000
PROCESSING_LEASE_SECONDS=900
PROCESSING_PRODUCTIVE_DELAY_MS=0
GENERAL_SYNC_UNIQUE_TARGETS_ENABLED=true
PROCESSING_PIPELINE_V2_ENABLED=true
PROCESSING_PIPELINE_SLIDING_WINDOW_ENABLED=true
PROCESSING_PIPELINE_SLIDING_WINDOW_V2_ENABLED=true
PROCESSING_GROUPED_PERSISTENCE_ENABLED=true
PROCESSING_WORKER_FINALIZATION_JIT_OFF=true
PROCESSING_WORKER_FINALIZATION_INCREMENTAL_TOTALS_ENABLED=false
PROCESSING_PERSISTENCE_PILOT_ENABLED=true
PROCESSING_GENERAL_SYNC_PERSISTENCE_PILOT_ENABLED=false
PROCESSING_GENERAL_SYNC_TWO_WAVE_PILOT_ENABLED=false
PROCESSING_PERSISTENCE_PROFILE_ENABLED=false
# Legado observado no ambiente; scheduler real e controlado pelo banco/UI.
PROCESSING_ALLOW_SCHEDULED_SYNC=false
# Defaults existentes do listener; iguais aos argumentos do timer homologado.
WORKER_WAKEUP_LIMIT=80
WORKER_WAKEUP_CONCURRENCY=80
WORKER_WAKEUP_MAX_CYCLES=10
