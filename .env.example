# PostgreSQL proprio
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=odontoart_pix
DATABASE_USER=odontoart_pix_app
DATABASE_PASSWORD=
DATABASE_SSL=false
DATABASE_POOL_MAX=20

# Autenticacao local
# Em producao HTTPS mantenha true. Em desenvolvimento HTTP local use false.
AUTH_COOKIE_SECURE=true

# ERP de mensalidades
MENSALIDADES_API_BASE_URL=
MENSALIDADES_API_TOKEN=
MENSALIDADES_API_CONNECT_TIMEOUT_MS=30000
MENSALIDADES_API_READ_TIMEOUT_MS=30000
MENSALIDADES_API_PAGE_SIZE=200
MENSALIDADES_API_MAX_PAGES=1000

# Worker PostgreSQL local
# Perfil Agressivo: bloco 80, concorrencia ERP 80, buffer 80 e delay produtivo zero.
# Os valores salvos em processing_settings no PostgreSQL prevalecem sobre estas variaveis.
# O instalador systemd do worker aplica DATABASE_POOL_MAX=80 somente ao worker.
PROCESSING_WORKER_COUNT=10
PROCESSING_BLOCK_SIZE=80
PROCESSING_CONCURRENCY=80
PROCESSING_ERP_CONCURRENCY=80
PROCESSING_PERSISTENCE_CONCURRENCY=1
PROCESSING_PERSISTENCE_BATCH_SIZE=15
PROCESSING_MAX_BUFFERED_RESULTS=80
# Otimizacao experimental: separar consulta ao ERP da persistencia.
# Mantenha false ate validar throughput e integridade em producao.
# Nao altera o perfil Agressivo, seus limites nem o timer systemd.
PROCESSING_PIPELINE_V2_ENABLED=false
# Janela movel experimental: requer PROCESSING_PIPELINE_V2_ENABLED=true.
# Modo desligado por padrao. Nao aumenta concorrencia maxima nem a fila em memoria;
# pode processar ate 2 blocos de claims por invocacao, com lanes de ate 8.
PROCESSING_PIPELINE_SLIDING_WINDOW_ENABLED=false
PROCESSING_LEASE_SECONDS=900
PROCESSING_WORKER_CYCLE_BUDGET_MS=110000
PROCESSING_STALE_HEARTBEAT_MS=120000
PROCESSING_MAX_ATTEMPTS=3
PROCESSING_PRODUCTIVE_DELAY_MS=0
PROCESSING_PERSISTENCE_RESERVE_MS=5000
PROCESSING_FINALIZATION_RESERVE_MS=8000
PROCESSING_SHUTDOWN_RESERVE_MS=9000

# A sincronizacao automatica e controlada em Configuracoes.
# processing_scheduler_state.scheduler_enabled e a fonte unica de verdade:
# false = somente sincronizacao manual; true = respeita o intervalo configurado.
