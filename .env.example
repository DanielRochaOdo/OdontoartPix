# PostgreSQL proprio
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=odontoart_pix
DATABASE_USER=odontoart_pix_app
DATABASE_PASSWORD=
DATABASE_SSL=false
DATABASE_POOL_MAX=20

# Autenticacao local
# Em producao HTTPS mantenha true. Em desenvolvimento HTTP local use false.
AUTH_COOKIE_SECURE=true

# ERP de mensalidades
MENSALIDADES_API_BASE_URL=
MENSALIDADES_API_TOKEN=
MENSALIDADES_API_CONNECT_TIMEOUT_MS=30000
MENSALIDADES_API_READ_TIMEOUT_MS=30000
MENSALIDADES_API_PAGE_SIZE=200
MENSALIDADES_API_MAX_PAGES=1000

# Worker PostgreSQL local
PROCESSING_WORKER_COUNT=10
PROCESSING_BLOCK_SIZE=60
PROCESSING_CONCURRENCY=15
PROCESSING_ERP_CONCURRENCY=15
PROCESSING_PERSISTENCE_CONCURRENCY=1
PROCESSING_PERSISTENCE_BATCH_SIZE=15
PROCESSING_MAX_BUFFERED_RESULTS=15
PROCESSING_LEASE_SECONDS=900
PROCESSING_WORKER_CYCLE_BUDGET_MS=110000
PROCESSING_STALE_HEARTBEAT_MS=120000
PROCESSING_MAX_ATTEMPTS=3
PROCESSING_PRODUCTIVE_DELAY_MS=10
PROCESSING_PERSISTENCE_RESERVE_MS=5000
PROCESSING_FINALIZATION_RESERVE_MS=8000
PROCESSING_SHUTDOWN_RESERVE_MS=9000

# Dupla trava do automatico:
# 1) esta variavel precisa ser true no processo do worker;
# 2) processing_scheduler_state.scheduler_enabled precisa estar true no banco.
# O padrao seguro e false ate a validacao final do ambiente.
PROCESSING_ALLOW_SCHEDULED_SYNC=false

# No primeiro corte, o preflight exige que as duas travas acima estejam desligadas.
# Altere para false apenas depois que o scheduler automatico for deliberadamente
# habilitado e ja tiver sido validado em producao.
PRODUCTION_PREFLIGHT_REQUIRE_SCHEDULER_OFF=true
