MENSALIDADES_API_BASE_URL=
MENSALIDADES_API_TOKEN=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Legado: a rota /api/cron/process-batches permanece protegida, mas retorna 410 e nunca processa.
CRON_SECRET=
# Usado somente pelas APIs de acao do usuario para acordar o GitHub worker.
# O automatico usa o mesmo token armazenado no Supabase Vault como
# odontoartpix_github_actions_token.
GITHUB_ACTIONS_TOKEN=
GITHUB_ACTIONS_REPO_OWNER=DanielRochaOdo
GITHUB_ACTIONS_REPO_NAME=OdontoartPix
GITHUB_ACTIONS_WORKFLOW_ID=process-batches.yml
GITHUB_ACTIONS_REF=main
PROCESSING_SYSTEM_USER_ID=
# Seguro por padrao. O workflow define true apenas quando source=scheduler.
PROCESSING_ALLOW_SCHEDULED_SYNC=false
PROCESSING_WORKER_COUNT=10
PROCESSING_BLOCK_SIZE=60
PROCESSING_CONCURRENCY=15
PROCESSING_ERP_CONCURRENCY=15
PROCESSING_LEASE_SECONDS=900
PROCESSING_WORKER_CYCLE_BUDGET_MS=110000
PROCESSING_STALE_HEARTBEAT_MS=120000
PROCESSING_MAX_ATTEMPTS=3
PROCESSING_PERSISTENCE_RESERVE_MS=5000
PROCESSING_FINALIZATION_RESERVE_MS=8000
PROCESSING_SHUTDOWN_RESERVE_MS=9000
MENSALIDADES_API_CONNECT_TIMEOUT_MS=30000
MENSALIDADES_API_READ_TIMEOUT_MS=30000
MENSALIDADES_API_PAGE_SIZE=200
MENSALIDADES_API_MAX_PAGES=1000
